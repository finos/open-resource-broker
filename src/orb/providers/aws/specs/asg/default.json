{
  "AutoScalingGroupName": {{ asg_name | tojson }},
  {% if has_abis or spot_count > 0 or has_machine_types %}"MixedInstancesPolicy": {
    "LaunchTemplate": {
      "LaunchTemplateSpecification": {
        "LaunchTemplateId": "{{ launch_template_id }}",
        "Version": "{{ launch_template_version }}"
      }{% if has_abis %},
      "Overrides": [
        {
          "InstanceRequirements": {{ abis_instance_requirements | tojson }}
        }
      ]{% elif has_machine_types %},
      "Overrides": [
        {% for mt in machine_types_overrides %}
        {
          "InstanceType": "{{ mt.instance_type }}"{% if mt.weighted_capacity %},
          "WeightedCapacity": "{{ mt.weighted_capacity }}"{% endif %}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]{% endif %}
    }{% if spot_count > 0 %},
    "InstancesDistribution": {
      "OnDemandBaseCapacity": 0,
      "OnDemandPercentageAboveBaseCapacity": {{ percent_on_demand }}{% if spot_allocation_strategy %},
      "SpotAllocationStrategy": {{ spot_allocation_strategy | tojson }}{% endif %}{% if on_demand_allocation_strategy %},
      "OnDemandAllocationStrategy": {{ on_demand_allocation_strategy | tojson }}{% endif %}
    }{% endif %}
  }{% else %}"LaunchTemplate": {
    "LaunchTemplateId": "{{ launch_template_id }}",
    "Version": "{{ launch_template_version }}"
  }{% endif %},
  "MinSize": {{ min_size }},
  "MaxSize": {{ max_size }},
  "DesiredCapacity": {{ desired_capacity }},
  "DefaultCooldown": {{ default_cooldown }},
  "HealthCheckType": "{{ health_check_type }}",
  "HealthCheckGracePeriod": {{ health_check_grace_period }}{% if has_subnets %},
  "VPCZoneIdentifier": "{{ vpc_zone_identifier }}"{% endif %}{% if has_context %},
  "Context": {{ context | tojson }}{% endif %},
  "Tags": [
    {% for tag in base_tags %}
    {
      "Key": {{ tag.key | tojson }},
      "Value": {{ tag.value | tojson }},
      "PropagateAtLaunch": true,
      "ResourceId": {{ asg_name | tojson }},
      "ResourceType": "auto-scaling-group"
    }{% if not loop.last or has_custom_tags %},{% endif %}
    {% endfor %}{% if has_custom_tags %}
    {% for tag in custom_tags %}
    {
      "Key": {{ tag.key | tojson }},
      "Value": {{ tag.value | tojson }},
      "PropagateAtLaunch": true,
      "ResourceId": {{ asg_name | tojson }},
      "ResourceType": "auto-scaling-group"
    }{% if not loop.last %},{% endif %}
    {% endfor %}{% endif %}
  ]
}
